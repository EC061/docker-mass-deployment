#!/bin/sh
# labquota — thin loader for the real program.
#
# The program itself is NOT baked into this image: the lab agent publishes it, alongside
# usage.json/status.json, into the root-owned directory it bind-mounts READ-ONLY at /run/labquota.
# That makes `labquota` updatable by upgrading the agent — no image rebuild and no container
# recreate (which would discard the container's writable layer and its weekly apt patches).
#
# Executed as `python3 <path>`, so the loader does not depend on the exec bit surviving the
# read-only bind mount. The directory is root-owned and outside every student-writable mount, so a
# student can read this program but never replace it.
set -eu

PROG="${LABQUOTA_DIR:-/run/labquota}/labquota"

if [ ! -f "$PROG" ]; then
    echo "labquota isn't available yet. The lab agent publishes it shortly after the" >&2
    echo "container starts; if this persists, contact your lab admin." >&2
    exit 1
fi

exec /usr/bin/python3 "$PROG" "$@"
